# Backend database path is optional; default: ./data/telisik.sqlite
# TELISIK_DB_PATH=C:/telisik-data/telisik.sqlite
# Frontend mode: scripts/start-local.cmd sets this for its process only.
# VITE_USE_LOCAL_API=true
# Gemini Service Account path (defaults to ./gemini_sa.json if present):
# GEMINI_SA_PATH=./gemini_sa.json
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_LOCATION=global
# Never put credentials in VITE_* variables or in the public/ folder.
